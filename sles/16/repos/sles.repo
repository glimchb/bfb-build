####################  NOTE ##################################
# Default: openSUSE Leap 16.0, which needs no registration.
#
# For a SLES build replace these with the SLES 16.0 (aarch64)
# product repositories (Pool and Updates) from SCC, RMT or SUSE Manager.
#############################################################

[leap-oss]
name=openSUSE Leap 16.0 OSS
baseurl=https://download.opensuse.org/distribution/leap/16.0/repo/oss/
enabled=1
autorefresh=1
gpgcheck=1
gpgkey=https://download.opensuse.org/distribution/leap/16.0/repo/oss/repodata/repomd.xml.key
priority=90
