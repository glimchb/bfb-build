####################  NOTE ##################################
# Default: openSUSE Leap 15.6, which is built from the SLES 15 SP6
# binaries and needs no registration.
#
# For a SLES build replace these with the SLES 15 SP6 (aarch64)
# Basesystem, Server Applications and Development Tools module
# repositories (Pool and Updates) from SCC, RMT or SUSE Manager.
#############################################################

[leap-oss]
name=openSUSE Leap 15.6 OSS
baseurl=https://download.opensuse.org/distribution/leap/15.6/repo/oss/
enabled=1
autorefresh=1
gpgcheck=1
gpgkey=https://download.opensuse.org/distribution/leap/15.6/repo/oss/repodata/repomd.xml.key
priority=90

[leap-update-sle]
name=openSUSE Leap 15.6 SLE updates
baseurl=https://download.opensuse.org/update/leap/15.6/sle/
enabled=1
autorefresh=1
gpgcheck=1
gpgkey=https://download.opensuse.org/update/leap/15.6/sle/repodata/repomd.xml.key
priority=90

[leap-update-oss]
name=openSUSE Leap 15.6 OSS updates
baseurl=https://download.opensuse.org/update/leap/15.6/oss/
enabled=1
autorefresh=1
gpgcheck=1
gpgkey=https://download.opensuse.org/update/leap/15.6/oss/repodata/repomd.xml.key
priority=90
